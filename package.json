{
  "name": "yomisuji",
  "version": "0.1.0",
  "private": true,
  "description": "好きな本を選ぶと、物語のどんな構造に惹かれているかがわかる読書タイプ診断",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "books:resolve": "node scripts/resolve-google-ids.mjs",
    "dev:vinext": "vite dev --port 3001",
