# Google Books API のキー（本の検索・表紙・おすすめの実在確認に使う）
GOOGLE_BOOKS_API_KEY=

# DeepSeek API のキー（本のタグ付け・分析・説明文・おすすめに使う。必須）
# https://platform.deepseek.com で発行
DEEPSEEK_API_KEY=
# 使うモデル（省略時は deepseek-flash。品質を上げたいときは deepseek-v4-pro）
# DEEPSEEK_MODEL=deepseek-flash
# 思考モード（初期はオフ。使用量が大きく増えるので、品質を比べたいときだけ enabled に）
# DEEPSEEK_THINKING=enabled

# 結果と本ごとのタグの保存先（本番では設定する。未設定なら .data/ にファイル保存）
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 公開先のURL（シェア画像を絶対URLにするために使う。本番では必ず設定）
# SITE_URL=https://example.com

# --- 開発・試験用 ---
# OG_FONT_FILE=/path/to/font.ttf                               # シェア画像用フォントをローカルから読む（Google Fonts につながらないとき）
# DEEPSEEK_MOCK=1                                              # DeepSeek を呼ばず模擬の結果を返す
# GOOGLE_BOOKS_API_BASE=http://localhost:4010/books/v1/volumes # 模擬 Google Books に向ける
